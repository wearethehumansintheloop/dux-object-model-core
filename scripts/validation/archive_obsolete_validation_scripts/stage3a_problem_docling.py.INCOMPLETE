#!/usr/bin/env python3
"""
Stage 3a: Problem Object Docling Processing

Uses the CORRECT DoclingDocument approach (table.data.grid breakthrough):
- Extracts Schema Attributes table using structured data
- Generates JSON schema from table structure
- Creates docling markdown with embedded schema
- No broken imports - self-contained with proven approach

Based on: watch_folders/hitl_workshop/fixed_docling_parser.py
"""

import json
from pathlib import Path
from typing import Dict, List, Any, Optional
from docling.document_converter import DocumentConverter

def extract_schema_table_from_docling(doc) -> Optional[Dict[str, Any]]:
    """
    Extract Schema Attributes table using DoclingDocument's structured data.
    
    KEY BREAKTHROUGH: DoclingDocument stores tables as structured TableItem objects
    with table.data.grid containing TableCell objects, NOT as pages/elements.
    """
    
    print("🔍 Searching for Schema Attributes table in DoclingDocument...")
    
    # Use table.data.grid (the breakthrough discovery!)
    for i, table in enumerate(doc.tables):
        print(f"📊 Examining table {i}: {type(table).__name__}")
        
        if hasattr(table, 'data') and table.data and hasattr(table.data, 'grid'):
            grid = table.data.grid
            print(f"  📋 Found table grid with {len(grid)} rows x {len(grid[0]) if grid else 0} cols")
            
            if len(grid) > 0 and len(grid[0]) >= 3:
                # Extract headers from first row
                headers = []
                for cell in grid[0]:
                    if hasattr(cell, 'text'):
                        headers.append(cell.text.strip())
                    else:
                        headers.append(str(cell).strip())
                
                print(f"  📝 Headers: {headers}")
                
                # Check if this looks like Schema Attributes table
                if any('attribute' in header.lower() for header in headers):
                    print("  ✅ Found Schema Attributes table!")
                    
                    # Extract data rows (skip header row)
                    attributes = []
                    for row_idx, row in enumerate(grid[1:], 1):
                        if len(row) >= 3:  # Ensure row has enough columns
                            # Extract cell text values
                            cells = []
                            for cell in row:
                                if hasattr(cell, 'text'):
                                    cells.append(cell.text.strip())
                                else:
                                    cells.append(str(cell).strip())
                            
                            # Create attribute object
                            attribute = {
                                'name': cells[0] if len(cells) > 0 else '',
                                'type': cells[1] if len(cells) > 1 else '',
                                'required': cells[2] if len(cells) > 2 else '',
                                'description': cells[3] if len(cells) > 3 else ''
                            }
                            
                            if attribute['name']:  # Only add if name exists
                                attributes.append(attribute)
                                print(f"    📄 {attribute['name']}: {attribute['type']} ({'req' if attribute['required'].lower() in ['yes', 'true'] else 'opt'})")
                    
                    return {
                        'headers': headers,
                        'attributes': attributes,
                        'table_index': i,
                        'source': 'docling_table_grid'
                    }
    
    print("❌ No Schema Attributes table found")
    return None


def generate_json_schema_from_attributes(attributes: List[Dict[str, Any]]) -> Dict[str, Any]:
    """Generate JSON schema from extracted attributes."""
    
    schema = {
        "type": "object",
        "properties": {},
        "required": []
    }
    
    for attr in attributes:
        name = attr['name']
        attr_type = attr['type'].lower()
        required = attr['required'].lower() in ['yes', 'true', 'required']
        description = attr['description']
        
        # Map attribute types to JSON schema types with detailed structures
        if attr_type == 'string':
            prop_def = {"type": "string"}
        elif attr_type == '[string]':
            prop_def = {"type": "array", "items": {"type": "string"}}
        elif attr_type == '[object]':
            # Detailed object array definitions based on field name
            if name == 'evidence':
                prop_def = {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "provenance_id": {"type": "string"},
                            "supports_fields": {"type": "array", "items": {"type": "string"}}
                        },
                        "required": ["provenance_id", "supports_fields"]
                    }
                }
            else:
                prop_def = {"type": "array", "items": {"type": "object"}}
        elif attr_type == 'object':
            # Detailed object definitions based on field name
            if name == 'job_statement':
                prop_def = {
                    "type": "object",
                    "properties": {
                        "user_scenario": {
                            "type": "object",
                            "properties": {
                                "value": {"type": "string"},
                                "source": {"type": "string", "enum": ["evidence", "synthetic"]}
                            },
                            "required": ["value", "source"]
                        },
                        "user_enablement": {
                            "type": "object",
                            "properties": {
                                "value": {"type": "string"},
                                "source": {"type": "string", "enum": ["evidence", "synthetic"]}
                            },
                            "required": ["value", "source"]
                        },
                        "user_outcome": {
                            "type": "object",
                            "properties": {
                                "value": {"type": "string"},
                                "source": {"type": "string", "enum": ["evidence", "synthetic"]}
                            },
                            "required": ["value", "source"]
                        }
                    },
                    "required": ["user_scenario", "user_enablement", "user_outcome"]
                }
            elif name == 'opportunity_score':
                prop_def = {
                    "type": "object",
                    "properties": {
                        "value": {"type": "number", "minimum": 1, "maximum": 20},
                        "importance": {"type": "number", "minimum": 1, "maximum": 10},
                        "satisfaction": {"type": "number", "minimum": 1, "maximum": 10},
                        "value_source": {"type": "string", "enum": ["evidence", "synthetic"]},
                        "importance_source": {"type": "string", "enum": ["evidence", "synthetic"]},
                        "satisfaction_source": {"type": "string", "enum": ["evidence", "synthetic"]}
                    },
                    "required": ["value", "importance", "satisfaction", "value_source", "importance_source", "satisfaction_source"]
                }
            else:
                prop_def = {"type": "object"}
        elif attr_type in ['number', 'integer']:
            prop_def = {"type": "number"}
        elif attr_type == 'boolean':
            prop_def = {"type": "boolean"}
        else:
            # Default to string for unknown types
            prop_def = {"type": "string"}
        
        if description:
            prop_def["description"] = description
        
        schema["properties"][name] = prop_def
        
        if required:
            schema["required"].append(name)
    
    return schema


def create_docling_markdown(original_content: str, json_schema: Dict[str, Any], attributes: List[Dict[str, Any]]) -> str:
    """Create docling markdown with embedded JSON schema."""
    
    # Extract title and key sections from original
    title_match = next((line for line in original_content.split('\n') if line.startswith('# ')), '# Problem Object')
    
    docling_content = f"""# 📋 Docling Processing Output

## 🎯 Original Object Definition
{title_match}

## 📋 Schema Attributes
| Attribute | Type | Required | Description |
|-----------|------|----------|-------------|
"""
    
    # Add attribute rows
    for attr in attributes:
        req_display = "Yes" if attr['required'].lower() in ['yes', 'true', 'required'] else "No"
        docling_content += f"| {attr['name']} | {attr['type']} | {req_display} | {attr['description']} |\n"
    
    docling_content += f"""
## 🔧 Generated JSON Schema (Proposal)
```json
{json.dumps(json_schema, indent=2)}
```

## 📊 Extraction Summary
- **Source**: DoclingDocument table.data.grid
- **Attributes Found**: {len(attributes)}
- **Required Fields**: {len(json_schema.get('required', []))}
- **Status**: Proposal (awaiting Stage 3b validation)

## ➡️ Next Stage
This proposal will be validated in Stage 3b against canonical governance schema.
"""
    
    return docling_content


def process_problem_object_stage3a(file_path: Path) -> Dict[str, Any]:
    """Main Stage 3a processing for Problem objects."""
    
    print(f"📋 Stage 3a: Processing {file_path.name}")
    
    try:
        # Read original markdown
        with open(file_path, 'r', encoding='utf-8') as f:
            content = f.read()
        
        # Convert with DoclingDocument
        converter = DocumentConverter()
        result = converter.convert(file_path)
        doc = result.document
        
        print(f"  ✓ DoclingDocument created with {len(doc.tables)} tables")
        
        # Extract schema table
        table_data = extract_schema_table_from_docling(doc)
        if not table_data:
            return {
                'success': False,
                'errors': ['No Schema Attributes table found in document']
            }
        
        attributes = table_data['attributes']
        print(f"  ✓ Extracted {len(attributes)} attributes")
        
        # Generate JSON schema
        json_schema = generate_json_schema_from_attributes(attributes)
        print(f"  ✓ Generated JSON schema with {len(json_schema['properties'])} properties")
        
        # Create docling markdown
        docling_content = create_docling_markdown(content, json_schema, attributes)
        
        # Save docling markdown
        docling_filename = file_path.stem + '_docling.md'
        docling_path = file_path.parent / docling_filename
        
        with open(docling_path, 'w', encoding='utf-8') as f:
            f.write(docling_content)
        
        print(f"  ✓ Created docling markdown: {docling_filename}")
        
        return {
            'success': True,
            'docling_file': docling_path,
            'attributes_count': len(attributes),
            'json_schema': json_schema,
            'stage': 'stage3a_completed',
            'next_stage': 'stage3b_validation'
        }
        
    except Exception as e:
        return {
            'success': False,
            'errors': [f'Stage 3a processing failed: {str(e)}']
        }


def main():
    """Run Stage 3a for Problem objects."""
    print("🔍 Stage 3a: Problem Object Docling Processing")
    print("=" * 60)
    print("Converting markdown to docling format with embedded JSON schema")
    print()
    
    import sys
    
    if len(sys.argv) > 1:
        # Process specific file
        file_path = Path(sys.argv[1])
        if not file_path.exists():
            print(f"❌ File not found: {file_path}")
            return
        
        result = process_problem_object_stage3a(file_path)
        
        if result['success']:
            print(f"\\n✅ Stage 3a Complete!")
            print(f"📁 Docling file: {result['docling_file']}")
            print(f"📊 Attributes: {result['attributes_count']}")
            print(f"➡️  Next: {result['next_stage']}")
        else:
            print(f"\\n❌ Stage 3a Failed:")
            for error in result['errors']:
                print(f"  - {error}")
    
    else:
        # Look for Problem objects in review folder
        review_dir = Path("watch_folders/hitl_review")
        if not review_dir.exists():
            print(f"❌ Review directory not found: {review_dir}")
            return
        
        problem_files = [f for f in review_dir.glob("problem_*_object_model_definition.md")]
        if not problem_files:
            print("📭 No Problem object files found")
            return
        
        for file_path in problem_files:
            print(f"\\n{'='*60}")
            result = process_problem_object_stage3a(file_path)
            
            if result['success']:
                print(f"\\n✅ {file_path.name} → Stage 3b")
            else:
                print(f"\\n❌ {file_path.name} → Failed")


if __name__ == "__main__":
    main()